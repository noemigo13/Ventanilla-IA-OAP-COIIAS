# Configuracion de Firebase: Project settings > General > "Tus apps" > App web
# (hay que registrar una app web dentro del proyecto de Firebase para verlos).
# Son valores seguros de exponer en el cliente segun el propio modelo de
# Firebase: la proteccion real la dan firestore.rules y Firebase Auth, no
# ocultar estas claves.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# "true" para conectar contra los emuladores locales (firebase emulators:start),
# en vez de contra el proyecto de Firebase real.
VITE_USE_FIREBASE_EMULATOR=false

# Clave de la API de Gemini (https://aistudio.google.com/apikey), usada SOLO por
# netlify/functions/generar-informe-ia.mts para el boton "Generar con IA" del
# editor de informe. A diferencia de las claves VITE_FIREBASE_* de arriba, esta
# SI es secreta: no lleva prefijo VITE_ a proposito para que Vite nunca la meta
# en el bundle del navegador. Solo hace falta para probar la funcion localmente
# con `netlify dev`; en produccion se define en Netlify (Site settings >
# Environment variables), nunca se sube al repositorio.
GEMINI_API_KEY=
